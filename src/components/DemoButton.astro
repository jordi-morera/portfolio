---
import type { Project } from '../data/projects';
interface Props { project: Project; size?: 'sm' | 'md' }
const { project: p, size = 'md' } = Astro.props;
const pad = size === 'sm' ? 'px-3 py-1.5 text-xs' : 'px-4 py-2 text-sm';
const primary = `inline-flex items-center gap-1.5 rounded-lg bg-accent-500 font-medium text-white shadow-sm transition hover:bg-accent-600 ${pad}`;
// Proyectos sin demo: el primer enlace destacado hace de botón principal
const mainLink = p.demoStatus === 'none' ? p.links?.[0] : undefined;
---
{p.demoUrl ? (
  <a href={p.demoUrl} target="_blank" rel="noopener" class={primary}>
    {p.demoStatus === 'mock' ? 'Try the demo' : 'Live demo'} ↗
  </a>
) : mainLink ? (
  <a href={mainLink.href} target="_blank" rel="noopener" class={primary}>{mainLink.label} ↗</a>
) : p.demoStatus === 'none' ? null : (
  <span class={`inline-flex cursor-default items-center rounded-lg border border-dashed border-stone-300 text-stone-500 dark:border-stone-700 ${pad}`}>
    Demo coming soon
  </span>
)}
