---
import type { Project } from '../data/projects';
import StackBadge from './StackBadge.astro';
import DemoButton from './DemoButton.astro';
interface Props { project: Project }
const { project: p } = Astro.props;
---
<article class="group flex flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-stone-800 dark:bg-stone-900">
  <div class="mb-2 flex items-center justify-between gap-2">
    <span class="text-xs font-medium uppercase tracking-wider text-accent-600 dark:text-accent-400">{p.category}</span>
    {p.demoUrl && <span class="flex items-center gap-1 text-xs text-stone-500"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>demo</span>}
  </div>
  <h3 class="text-lg font-semibold tracking-tight">
    <a href={`/projects/${p.slug}/`} class="group-hover:text-accent-600 dark:group-hover:text-accent-400">{p.name}</a>
  </h3>
  <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">{p.tagline}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {p.stack.slice(0, 5).map((s) => <StackBadge label={s} />)}
    {p.stack.length > 5 && <span class="px-1 text-xs text-stone-400">+{p.stack.length - 5}</span>}
  </div>
  <div class="mt-auto flex items-center gap-3 pt-5">
    <DemoButton project={p} size="sm" />
    <a href={`/projects/${p.slug}/`} class="text-xs font-medium text-stone-600 hover:text-accent-600 dark:text-stone-400">Details →</a>
  </div>
</article>
