---
import Base from '../../layouts/Base.astro';
import StackBadge from '../../components/StackBadge.astro';
import DemoButton from '../../components/DemoButton.astro';
import { projects, getProject, type Project } from '../../data/projects';
import { loadReadme } from '../../lib/readme';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

interface Props { project: Project }
const { project: p } = Astro.props;
const readme = await loadReadme(p);
const repoUrl = p.repo ? `https://github.com/${p.repo}` : null;
const related = (p.related ?? []).map(getProject).filter((r: Project | undefined): r is Project => Boolean(r));
// El primer enlace ya sale como botón principal cuando no hay demo
const extraLinks = p.demoStatus === 'none' ? (p.links ?? []).slice(1) : (p.links ?? []);
---
<Base title={p.name} description={p.tagline}>
  <a href="/#projects" class="mt-8 inline-block text-sm text-stone-500 hover:text-accent-600">← All projects</a>

  <!-- Pitch: lo que un recruiter lee en 30 segundos -->
  <section class="mt-6 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8 dark:border-stone-800 dark:bg-stone-900">
    <span class="text-xs font-medium uppercase tracking-wider text-accent-600 dark:text-accent-400">{p.category}</span>
    <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">{p.name}</h1>
    <p class="mt-2 text-lg text-stone-600 dark:text-stone-400">{p.tagline}</p>
    <p class="mt-5 max-w-3xl leading-relaxed">{p.pitch}</p>

    <ul class="mt-5 grid gap-2 text-sm sm:grid-cols-3">
      {p.highlights.map((h) => (
        <li class="rounded-lg bg-accent-50 px-3 py-2 text-stone-700 dark:bg-stone-800 dark:text-stone-300">✓ {h}</li>
      ))}
    </ul>

    <div class="mt-5 flex flex-wrap gap-1.5">{p.stack.map((s) => <StackBadge label={s} />)}</div>

    <div class="mt-7 flex flex-wrap items-center gap-3">
      <DemoButton project={p} />
      {extraLinks.map((l) => (
        <a href={l.href} target="_blank" rel="noopener" class="rounded-lg border border-stone-300 px-4 py-2 text-sm hover:border-stone-500 dark:border-stone-700">{l.label} ↗</a>
      ))}
      {repoUrl && (
        <a href={repoUrl} target="_blank" rel="noopener" class="rounded-lg border border-stone-300 px-4 py-2 text-sm hover:border-stone-500 dark:border-stone-700">Source code ↗</a>
      )}
    </div>
    {(p.demoNote || p.demoCredentials) && (
      <p class="mt-3 text-xs text-stone-500">
        {p.demoNote}
        {p.demoCredentials && <> · Demo login: <code class="rounded bg-stone-100 px-1 dark:bg-stone-800">{p.demoCredentials.user}</code> / <code class="rounded bg-stone-100 px-1 dark:bg-stone-800">{p.demoCredentials.password}</code></>}
      </p>
    )}
  </section>

  {related.length > 0 && (
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-500">Related projects</h2>
      <div class="mt-3 flex flex-wrap gap-3">
        {related.map((r) => (
          <a href={`/projects/${r.slug}/`} class="rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm shadow-sm transition hover:border-accent-500 dark:border-stone-800 dark:bg-stone-900">
            <span class="font-medium">{r.name}</span>
            <span class="block text-xs text-stone-500">{r.tagline}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- README completo del repo -->
  <section class="mt-12">
    <div class="mb-4 flex items-baseline justify-between border-b border-stone-200 pb-2 dark:border-stone-800">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-500">README</h2>
      {readme.source === 'github' && repoUrl && <a href={repoUrl} target="_blank" rel="noopener" class="text-xs text-stone-400 hover:text-accent-600">synced from GitHub</a>}
    </div>
    {readme.html ? (
      <article class="prose prose-stone max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:text-accent-600 prose-pre:bg-stone-900 prose-img:rounded-xl" set:html={readme.html} />
    ) : (
      <p class="text-stone-500">README not available yet.</p>
    )}
  </section>
</Base>
