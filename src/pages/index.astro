---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---
<Base>
  <section class="py-20 sm:py-28">
    <p class="text-sm font-medium text-accent-600 dark:text-accent-400">{site.role} · {site.location}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Hi, I’m {site.name.split(' ')[0]}.</h1>
    <p class="mt-5 max-w-2xl text-lg text-stone-600 dark:text-stone-400">{site.tagline}</p>
    <div class="mt-8 flex flex-wrap gap-3 text-sm">
      <a href="#projects" class="rounded-lg bg-stone-900 px-4 py-2 font-medium text-white hover:bg-stone-700 dark:bg-stone-100 dark:text-stone-900 dark:hover:bg-white">See projects</a>
      <a href={site.github} target="_blank" rel="noopener" class="rounded-lg border border-stone-300 px-4 py-2 hover:border-stone-500 dark:border-stone-700">GitHub ↗</a>
      {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener" class="rounded-lg border border-stone-300 px-4 py-2 hover:border-stone-500 dark:border-stone-700">LinkedIn ↗</a>}
      <a href={`mailto:${site.email}`} class="rounded-lg border border-stone-300 px-4 py-2 hover:border-stone-500 dark:border-stone-700">Contact</a>
    </div>
  </section>

  <section id="projects" class="scroll-mt-20">
    <h2 class="text-2xl font-semibold tracking-tight">Featured projects</h2>
    <p class="mt-1 text-sm text-stone-500">AI + psychology: products where technology serves emotional wellbeing.</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>

    <h2 class="mt-16 text-2xl font-semibold tracking-tight">More projects</h2>
    <p class="mt-1 text-sm text-stone-500">Backend craftsmanship on the Java / Spring ecosystem and frontend experiments.</p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {others.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section id="about" class="mt-24 scroll-mt-20 grid gap-8 sm:grid-cols-3">
    <h2 class="text-2xl font-semibold tracking-tight">About</h2>
    <div class="space-y-4 text-stone-600 sm:col-span-2 dark:text-stone-400">
      <p>
        I’ve spent 19+ years building backend systems in Java — mostly Spring Boot and AEM in enterprise environments.
        Lately I’ve been combining that engineering foundation with applied AI (LLM orchestration, agents, prompt design).
      </p>
      <p>
        My long-term goal is to bring AI and psychology together: tools that help people understand their emotions,
        built responsibly, with safety and human care designed in from day one.
      </p>
    </div>
  </section>
</Base>
